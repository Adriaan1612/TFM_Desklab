// Prisma schema — Fase 2: catálogo + setups (lectura).
// Alcance estricto: Product, Setup, SetupItem + enums.
// Fuera de esta fase: User, Cart, Order, SavedSetup y persistencia del
// cuestionario IA (ver docs/product.md y docs/data-model.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Lighting
  Organization
  Peripherals
  Monitors
  Stands
  Decoration
}

enum Style {
  Minimal
  Natural
  Dark
  RGB
}

enum Use {
  Work
  Gaming
  Study
  Streaming
  Mixed
}

enum Slot {
  Monitor
  MonitorArm
  Keyboard
  Mouse
  DeskMat
  Lighting
  Organization
  Decoration
}

model Product {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  category   Category
  slot       Slot
  styles     Style[]
  uses       Use[]
  priceCents Int
  imageUrl   String?
  createdAt  DateTime   @default(now())
  setupItems SetupItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([slot])
}

model Setup {
  id        String      @id @default(cuid())
  slug      String      @unique
  name      String
  use       Use
  style     Style
  createdAt DateTime    @default(now())
  items     SetupItem[]

  @@index([use])
  @@index([style])
}

model SetupItem {
  id        String  @id @default(cuid())
  setupId   String
  slot      Slot
  productId String

  setup   Setup   @relation(fields: [setupId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([setupId, slot])
  @@index([productId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  userId      String?
  email       String
  name        String
  address     String
  city        String
  postalCode  String
  totalCents  Int
  createdAt   DateTime    @default(now())
  items       OrderItem[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  name       String
  priceCents Int
  quantity   Int
  setupSlug  String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
