// Prisma schema — Fase 1: solo datasource + generator.
// No crear modelos definitivos todavía (catálogo, usuarios, pedidos, IA).
// Se definirán en la fase "Modelo de datos".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
